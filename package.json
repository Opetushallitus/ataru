{
  "name": "lomake-editori",
  "repository": {
    "type": "git",
    "url": "https://github.com/Opetushallitus/lomake-editori.git"
  },
  "license": "EUPL-1.1",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prepare": "husky",
    "cypress:open": "cypress open -C oph-configuration/cypress.json",
    "cypress:run": "cypress run -C oph-configuration/cypress.json --browser chrome --headless",
    "cypress:run:ci": "cypress run -C oph-configuration/cypress.ci.json --browser chrome --headless",
    "lint:clj": "clj-kondo --lint src --fail-level error",
    "clj-kondo:dep-configs": "clj-kondo --lint \"$(lein classpath)\" --dependencies --copy-configs",
    "lint:js": "eslint '**/*.{ts,js}'",
    "lint:js:fix": "eslint --fix '**/*.{ts,js}'",
    "tsc:type-check": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --no-warn-ignored"
    ],
    "!(.clj-kondo/**/*)*.{clj,cljs,cljc}": [
      "clj-kondo --lint"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.12.2",
    "clj-kondo": "^2024.2.12",
    "cypress": "^4.12.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "5.5.6",
    "fp-ts": "2.16.8",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "husky": "9.1.1",
    "less": "^4.2.0",
    "lint-staged": "17.6.0",
    "pm2": "7.0.4",
    "prettier": "3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0"
  }
}
